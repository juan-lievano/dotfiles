# Ghostty config, ported from .config/wezterm/wezterm.lua. Daily driver again
# on trial since 2026-09-13 (Hyper+1 in .config/skhd/open-app-slot.sh);
# WezTerm stays installed (clickable file links, maybe multiplexing someday).
# Ghostty is also the only terminal Apple's built-in dictation will type into
# (dictation ignores WezTerm entirely). Earlier trial 2026-08-18..26 ended
# because dictation didn't get used enough to justify it.
# Reference for every key: `ghostty +show-config --default --docs`.

# font-family is deliberately unset: Ghostty ships JetBrains Mono built in
# (same face WezTerm bundles), so unset = JetBrains Mono, no font install.
font-size = 15

# WezTerm: window_background_opacity 0.90 / macos_window_background_blur 92.
# Both terminals feed the blur number to the same private CoreGraphics call,
# so 92 means the same thing here. Ghostty's docs warn >20 "may cause strange
# rendering" -- if it does, drop toward 20.
# Used fullscreen ~always: there the only thing behind the window is the
# Space's wallpaper, so transparency just leaks it (dark) into the terminal
# and dims the painting. Keep this near 1; the frosted painting below is
# what makes it look like glass. Blur only matters in a windowed layout.
background-opacity = 0.95
background-blur = 200

cursor-style-blink = false

# Pointer disappears on the first keystroke, back on mouse move. WezTerm's
# default; Ghostty defaults it off. No idle timeout exists in either.
mouse-hide-while-typing = true

# Bell off: the 🔔 tab glyph is hard-coded, the border is invisible from
# another tab, and most rings are completion noise. Never missed it in WezTerm.
bell-features = no-attention,no-title,no-border

# No titlebar at all. Tabs moved to tmux (2026-10-02), so the native tab strip
# is dead weight; `hidden` also sets tabbingMode = .disallowed (Cmd-T opens a
# window). Before this: `macos-titlebar-style = tabs` painted the titlebar as
# the tab strip, with `title = " "` blanking it; see git history for that
# setup if Ghostty tabs come back.
macos-titlebar-style = hidden

# Both Options compose dead keys (Opt-e then a vowel -> á), same as
# wezterm.lua's send_composed_key_when_left_alt_is_pressed. Right Option is
# eaten by kanata's launch layer and the home-row Option under `d` is Left,
# so Left is the one that must compose. Nothing here uses Option as Meta
# (zsh is in vi mode; delete-word is ^W). Must be explicit: unset defaults
# to `true` on U.S. layouts. Combos with no printable result (Opt-Ctrl-a)
# still reach the terminal as Alt regardless.
macos-option-as-alt = false

# --- Colors -----------------------------------------------------------------
# `termbg IMAGE` (~/.local/bin) writes themes/from-image from the image's
# colors (img2palette: k-means, clusters mapped to ANSI slots by hue) and
# drops the image at the fixed path below, so swapping the picture never
# touches this file. A theme sets palette/fg/bg/cursor/selection at once;
# any of those keys written here would override it. nvim/zsh/ls name ANSI
# slots only, so they follow whatever theme is loaded. Previous schemes:
# Catppuccin Frappe/Mocha (9abd7ac), cream e6c9a8 on black (f8085c0).
theme = from-image

# Used fullscreen ~always. Opacity is relative to background-opacity
# (0.95 * 0.35 = ~0.33 on screen). `cover` fills the window, cropping edges.
# Ghostty 1.2+ draws it per split, not per window. current-frosted.jpg is
# the image through `magick -blur 0x14` (background-blur only frosts what is
# behind the window, never the image). Not in the repo: pictures are big
# and often in copyright; current.txt beside it records the source.
background-image = ~/Pictures/terminal/current-frosted.jpg
background-image-opacity = 0.35
background-image-fit = cover

# --- Keys -------------------------------------------------------------------
# Fullscreen. Hyper+F is a system-wide macOS shortcut (System Settings >
# Keyboard > App Shortcuts) aimed at menu items titled "Enter/Exit Full
# Screen". Ghostty's item is "Toggle Full Screen", so macOS never matches it;
# bind the chord here instead. Native fullscreen (own Space), same as before.
# Ghostty's own defaults, Cmd-Enter and Cmd-Ctrl-F, still work too.
keybind = super+ctrl+alt+shift+f=toggle_fullscreen

# Cmd-M: swallow it. Only ever minimize by accident. (WezTerm: CMD-m -> Nop.)
keybind = super+m=ignore

# Splits belong to tmux (prefix | and _). Cmd-D / Cmd-Shift-D only ever fired
# by accident.
keybind = super+d=unbind
keybind = super+shift+d=unbind

# Tabs belong to tmux too (2026-10-02): every default tab action unbound, so
# the chords pass through to the terminal instead of silently doing nothing
# (titlebar `hidden` already disallows tabbing; Cmd-T would open a window).
# List from `ghostty +show-config --default | grep tab` (1.3.1). Cmd-W
# (close_surface) and Cmd-N (new_window) stay: they're windows, not tabs.
#
# Cmd-N -> tmux window N: considered 2026-10-04, not done. tmux can't see Cmd,
# so it would have to be Ghostty typing the prefix for you
# (`keybind = super+1=text:\x011`, Ctrl-A then 1). That is sent blindly:
# outside tmux, Cmd-3 jumps to start of line and types a 3; over ssh it goes
# to whichever tmux has the Ctrl-A prefix. Fine if always in local tmux.
keybind = super+t=unbind
keybind = super+alt+w=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind
keybind = super+shift+[=unbind
keybind = super+shift+]=unbind
keybind = super+1=unbind
keybind = super+2=unbind
keybind = super+3=unbind
keybind = super+4=unbind
keybind = super+5=unbind
keybind = super+6=unbind
keybind = super+7=unbind
keybind = super+8=unbind
keybind = super+9=unbind
keybind = super+digit_1=unbind
keybind = super+digit_2=unbind
keybind = super+digit_3=unbind
keybind = super+digit_4=unbind
keybind = super+digit_5=unbind
keybind = super+digit_6=unbind
keybind = super+digit_7=unbind
keybind = super+digit_8=unbind

# Ghostty, unlike WezTerm, ships Cmd-Backspace = Ctrl-U (kill line) out of the
# box -- it sees the GUI key event and synthesizes ^U before the terminal
# encoding drops Cmd. wezterm.lua deliberately does NOT translate Opt/Cmd-
# Backspace: in the terminal delete-word/delete-line are ^W/^U and that's the
# one rule here. Keeping that rule; delete this line to get kill-line back.
keybind = super+backspace=unbind

# Not ported: wezterm.lua's window-focus-changed hook (unfocused window drops
# to 0.40 opacity). Ghostty has no unfocused-*window* opacity, only
# unfocused-split-opacity, so this is the one visible thing that's gone.

# Sioyek user prefs. Read from ~/.config/sioyek/ on macOS (pdf_viewer/main.cpp,
# configure_paths); overrides the bundled defaults in
# /Applications/sioyek.app/Contents/MacOS/prefs.config, which documents every
# knob. Databases (bookmarks, highlights, last position) live in
# ~/Library/Application Support/sioyek/ and are not tracked.

# One window, like a browser with one tab: a PDF opened from Finder/`open`
# replaces the one on screen; `O` fuzzy-lists everything opened before and
# Backspace walks back through history. Sioyek has no tabs.
should_launch_new_window 0
should_launch_new_instance 0

# Fullscreen from the first launch; F11 toggles it off.
startup_commands toggle_fullscreen

# Reveal the current PDF in Finder (bound to gf in keys_user.config).
new_command _reveal open -R %{file_path}

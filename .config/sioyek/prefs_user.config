# Sioyek user prefs. Read from ~/.config/sioyek/ on macOS (pdf_viewer/main.cpp,
# configure_paths); overrides the bundled defaults in
# /Applications/sioyek.app/Contents/MacOS/prefs.config, which documents every
# knob. Databases (bookmarks, highlights, last position) live in
# ~/Library/Application Support/sioyek/ and are not tracked.

# One window, like a browser with one tab: a PDF opened from Finder/`open`
# replaces the one on screen; `O` fuzzy-lists everything opened before and
# Backspace walks back through history. Sioyek has no tabs.
should_launch_new_window 0
should_launch_new_instance 0
# Recent list (O): the only knob is show_doc_path (file name vs full path,
# nothing in between). Left at file name; the second column is the PDF title
# from \title{}, which is what tells report.pdf files apart.

# Not fullscreen at launch: a macOS fullscreen window lives in its own Space,
# so `open file.pdf` from a terminal did not switch to it (tried 2026-10-14).

# Reveal the current PDF in Finder (bound to gf in keys_user.config).
new_command _reveal open -R %{file_path}

# --- Look like the terminal -------------------------------------------------
# Colours copied by hand from .config/ghostty/themes/from-image on 2026-10-14:
# bg/fg for the menus, cursor-color/cursor-text for the selected row (the
# theme's grey selection had too little contrast against the text). `termbg`
# regenerates that theme from the wallpaper and does not touch this file, so
# redo these if the picture changes. Sioyek takes 0-1 floats, no alpha: the
# menus cannot be translucent. JetBrains Mono is bundled inside sioyek.app
# (Qt resource), same face Ghostty ships; 15 matches Ghostty's font-size.
ui_font JetBrains Mono
font_size 15
ui_background_color 0.082 0.125 0.196
ui_text_color 0.792 0.824 0.710
ui_selected_background_color 0.686 0.824 0.957
ui_selected_text_color 0.082 0.125 0.196
status_bar_color 0.082 0.125 0.196
status_bar_text_color 0.792 0.824 0.710
status_bar_font_size 15
# Margin around the page, and the titlebar when not fullscreen.
background_color 0.082 0.125 0.196
dark_mode_background_color 0.082 0.125 0.196
macos_titlebar_color 0.082 0.125 0.196
# `toggle_custom_color` (via :) repaints the page itself in terminal colours;
# F8 dark mode is a plain invert and is left alone.
custom_background_color 0.082 0.125 0.196
custom_text_color 0.792 0.824 0.710

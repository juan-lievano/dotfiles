# Sioyek key overrides; same lookup as prefs_user.config. Defaults are in
# /Applications/sioyek.app/Contents/MacOS/keys.config (vim-ish: j/k, gg/G,
# / search, t TOC, o open, F8 dark mode, F11 fullscreen, : command palette).

# vim half-page scroll; unbound by default and untouched by the kanata/skhd
# Ctrl rewrites (those only touch H M [ ;).
screen_down <C-d>
screen_up <C-u>

# Reveal the current PDF in Finder (new_command _reveal in prefs_user.config).
_reveal gf

# Sioyek key overrides; same lookup as prefs_user.config. Defaults are in
# /Applications/sioyek.app/Contents/MacOS/keys.config (vim-ish: j/k, gg/G,
# / search, t TOC, o open, F8 dark mode, F11 fullscreen, : command palette).

# vim half-page scroll; unbound by default and untouched by the kanata/skhd
# Ctrl rewrites (those only touch H M [ ;).
screen_down <C-d>
screen_up <C-u>

# Reveal the current PDF in Finder (new_command _reveal in prefs_user.config).
_reveal gf

# Jump history like nvim's jumplist. Defaults are Backspace / Shift-Backspace
# (browser-style); Ctrl-O was sioyek's own file browser, moved to go below.
prev_state <C-o>
next_state <C-i>
open_document_embedded go

# Menus (O, t, :, gb ...): Ctrl-N/P move the selection. `[m]` scopes the
# macro to menus, so outside one these keys stay unbound; inside one the
# line edit hands modifier chords to the input handler (ui.cpp
# MyLineEdit::keyPressEvent) and plain keys keep typing into the filter.
# Not in any default file; syntax from github.com/ahrm/sioyek/issues/1231.
# Other actions: page_down page_up menu_begin menu_end select.
[m]control_menu(down) <C-n>
[m]control_menu(up) <C-p>

# Cmd-W (<D-> is Cmd; <C-> is Ctrl) closes the window by default, which on the
# only window leaves a windowless process behind; `open x.pdf` and
# Hyper-3 then activate an app with nothing to show (found 2026-10-14).
# Quit instead; the next open relaunches it with a window.
quit <D-w>

# Copy the selection (default is only Ctrl-C). Needs a mouse selection or a
# visual mark; with nothing selected it copies nothing.
copy y

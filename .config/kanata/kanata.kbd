;; kanata config — port of .config/karabiner/karabiner.json plus home row mods.
;;
;; Design notes:
;;   * Home row mods are the reason for switching; everything else is carried
;;     over from Karabiner as faithfully as kanata allows.
;;   * kanata has NO frontmost-application awareness. The Karabiner rules that
;;     used `frontmost_application_unless` (Ctrl-W, Ctrl-U) are deliberately
;;     NOT ported. In the terminal, Ctrl-W and Ctrl-U already do delete-word /
;;     delete-line natively in both zsh and nvim insert mode, which is exactly
;;     what those exclusions were protecting. Outside the terminal, use
;;     Ctrl-Opt-H (delete word) and Ctrl-Cmd-H (delete line).
;;   * `unmod` below drops Ctrl but leaves Opt/Cmd held, reproducing Karabiner's
;;     `optional: ["any"]` modifier passthrough.
;;   * Chordal hold means SAME-HAND combos never fire the modifier, so reach
;;     for the Ctrl on the OPPOSITE hand from the letter:
;;         Ctrl-W  -> `l`+w   (w is left-hand, so use right Ctrl)
;;         Ctrl-H  -> `s`+h   (h is right-hand, so use left Ctrl)
;;         Ctrl-U  -> `s`+u     Ctrl-M -> `s`+m     Ctrl-N/P -> `s`+n / `s`+p
;;     Caps Lock stays mapped to Ctrl as the escape hatch that always works
;;     regardless of which hand the letter is on.
;;   * The app launcher lives in skhd (.config/skhd/skhdrc). kanata only
;;     converts Space+N into Hyper+N; the Voyager already sends Hyper+N in
;;     firmware. Both keyboards converge on one catcher.
;;   * The function row is remapped BACK to its macOS media functions. This is
;;     not a preference, it's a repair -- see the deflayer comment below.

(defcfg
  process-unmapped-keys yes   ;; keys absent from defsrc pass through untouched
  concurrent-tap-hold yes     ;; required to chord two home row mods at once

  ;; Built-in keyboard ONLY. The Voyager has its own firmware mods and layers;
  ;; letting kanata also apply home row mods to it would double-process every
  ;; keystroke. Names come from `kanata --list`.
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lalt lmet spc  rmet ralt
)

(defvar
  ;; tap-time: how long after release a re-press still counts as a tap
  ;; hold-time: how long to hold before the modifier engages
  tap-time  200
  hold-time 200

  ;; Chordal hold ("opposite hand rule"): pressing one of these while the
  ;; same-hand mod is held settles the mod as a TAP, so same-hand rolls
  ;; (e.g. "as", "de", "jk") type letters instead of firing modifiers.
  ;; Mirrors QMK's chordal_hold_layout, which Oryx guesses from geometry.
  ;;
  ;; The home row mod keys themselves (a s d f / j k l ;) are deliberately
  ;; ABSENT from their own hand's list, so that same-hand mods can be CHAINED:
  ;; s+f+h is Ctrl-Cmd-H (delete to line start). With `f` in the left list,
  ;; pressing it early-tapped `s` into a literal "s" and left Cmd-H = Hide
  ;; Window. QMK does the same thing -- "as an exception to the opposite hands
  ;; rule, Chordal Hold supports combining multiple same-side modifiers within
  ;; the tapping term" -- so this is closer to the Voyager, not further.
  ;; Cost: a genuinely slow same-hand roll (holding `a` past 200ms while
  ;; hitting `s`) can fire Shift. The Voyager has that same exposure.
  left-hand-keys (
    q w e r t
    g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h
    n m , . /
  )
)

(defalias
  ;; ---- Ctrl-<key> rewrites (global; no app conditions) ----
  ;; (fork <normal> <alternate> <trigger-keys>)
  ;; Ctrl held -> alternate. `unmod` releases only Ctrl, so Opt and Cmd
  ;; still reach the output:
  ;;   Ctrl-H      -> Delete
  ;;   Ctrl-Opt-H  -> Opt-Delete   (delete word)
  ;;   Ctrl-Cmd-H  -> Cmd-Delete   (delete to line start)
  ctlh (fork h (unmod (lctl rctl) bspc) (lctl rctl))
  ctlb (fork [ (unmod (lctl rctl) esc)  (lctl rctl))
  ;; Ctrl-M lives on @symm below, not here: `m` is a tap-hold, so the fork has
  ;; to wrap it rather than sit inside it. See the note there.
  ;; Ctrl-; -> ~ lives in defoverrides at the bottom: `unmod` only accepts
  ;; plain key names, not shifted forms like S-grv.

  ;; ---- Ctrl-N / Ctrl-P -> Down / Up  (PENDING DECISION, not wired up) ----
  ;; Was Spotlight list navigation in Karabiner, excluded in terminals.
  ;; Going global costs exactly one thing: nvim insert-mode keyword
  ;; completion (verified — <C-n> completes, <Down> does not). Recover it
  ;; with a line in init.lua:
  ;;     vim.keymap.set("i", "<C-Space>", "<C-n>")
  ;; Skip all of this if you switch to Raycast, which navigates with
  ;; Ctrl-N/P natively. To enable: uncomment these two, put @ctlp in place
  ;; of `p` in the base layer, and make @ctln the TAP action of @navn below
  ;; (`n` no longer sits in the base layer directly).
  ;; ctln (fork n (unmod (lctl rctl) down) (lctl rctl))
  ;; ctlp (fork p (unmod (lctl rctl) up)   (lctl rctl))

  ;; ---- Home row mods, index finger inward: Cmd Opt Ctrl Shift ----
  ;; `tap-hold-tap-keys`, NOT `tap-hold-release-keys`, so that both keyboards
  ;; feel the same. The Voyager runs QMK Chordal Hold with Permissive Hold and
  ;; Hold-On-Other-Key-Press both OFF (Oryx defaults), and QMK's docs are
  ;; explicit that with those off, "if the keys are on opposite hands, Chordal
  ;; Hold introduces no new behavior" -- a cross-hand roll finished inside the
  ;; tapping term is a TAP, and the mod only fires past the full timeout.
  ;; `tap-hold-release-keys` is Permissive Hold ("activate hold early if
  ;; another key is pressed and released"), so it fired modifiers on fast
  ;; cross-hand rolls that the Voyager types straight through.
  ;; `tap-hold-tap-keys` has the identical signature but waits out the full
  ;; $hold-time, which is the QMK-default behaviour.
  ;;
  ;; Cost of parity: deliberate mods are slower. Ctrl-W is hold `l` for the
  ;; full 200ms, THEN w -- you can't roll into it. Same as on the Voyager.
  ;;
  ;; Do NOT add `tap-hold-require-prior-idle` (ZMK's require-prior-idle-ms /
  ;; QMK's Flow Tap). It would cut misfires further, but FLOW_TAP_TERM is off
  ;; on the Voyager, so it would make the two keyboards diverge again. If it's
  ;; ever wanted, turn it on in Oryx first.
  ;; $tap-time here is the tap-repress timeout = QMK's QUICK_TAP_TERM (200),
  ;; and $hold-time = TAPPING_TERM (200). Both already match Oryx.
  hma (tap-hold-tap-keys $tap-time $hold-time a     lsft $left-hand-keys)
  hms (tap-hold-tap-keys $tap-time $hold-time s     lctl $left-hand-keys)
  hmd (tap-hold-tap-keys $tap-time $hold-time d     lalt $left-hand-keys)
  hmf (tap-hold-tap-keys $tap-time $hold-time f     lmet $left-hand-keys)
  hmj (tap-hold-tap-keys $tap-time $hold-time j     rmet $right-hand-keys)
  hmk (tap-hold-tap-keys $tap-time $hold-time k     ralt $right-hand-keys)
  hml (tap-hold-tap-keys $tap-time $hold-time l     rctl $right-hand-keys)
  hmsc (tap-hold-tap-keys $tap-time $hold-time ;     rsft $right-hand-keys)

  ;; ---- App launcher: hold Space, tap 1-7 ----
  ;; Replaces Karabiner's simultaneous Space+N. Tapping Space still types
  ;; a space.
  ;;
  ;; Homebrew's kanata is built WITHOUT the `cmd` feature ("kanata was
  ;; compiled to never allow cmd"), so it cannot run open-app-slot.sh
  ;; itself. Instead it emits Hyper+N and a userspace hotkey daemon (skhd,
  ;; Raycast, ...) runs the script. Hyper is also reachable directly from
  ;; the home row by holding a+s+d+f together.
  spc  (tap-hold $tap-time $hold-time spc (layer-while-held launch))

  ;; ---- Symbol / navigation layers: hold `m` or `n` ----
  ;; Both live on the right index finger and both layers put their payload on
  ;; the LEFT hand, so the layer key is never on the same hand as what it
  ;; produces -- the same opposite-hand rule the home row mods follow.
  ;;
  ;; $right-hand-keys is passed for the same reason it is on @hmj..@hmsc: a
  ;; fast right-hand roll ("mn", "m,") settles as a tap instead of opening a
  ;; layer. The left-hand payload keys aren't in that list, so they still
  ;; require the full $hold-time -- symbols and arrows can't be rolled into,
  ;; you hold and then press, exactly like a deliberate home row mod.
  ;;
  ;; Cost: `m` and `n` lose key repeat, and any mid-word hesitation on them
  ;; past 200ms opens a layer. Same exposure a/s/d/f/j/k/l/; already carry.
  ;;
  ;; Ctrl-M -> Return forks OUTSIDE the tap-hold, not in its tap action, so it
  ;; resolves when `m` goes down rather than when it comes back up. As a tap
  ;; action it fired on release and the fork read Ctrl at that instant, so
  ;; releasing `s` a hair early typed a literal "m"; on press there is also no
  ;; tap-hold wait, and Return lands while you are still holding the chord.
  ;; @ctlh and @ctlb don't need this -- `h` and `[` are plain keys.
  ;; Cost: with Ctrl already down, `m`-hold repeats Return instead of opening
  ;; symbols. Pressing Ctrl AFTER `m` is unaffected; the fork is already past.
  symm (fork
         (tap-hold-tap-keys $tap-time $hold-time m (layer-while-held symbols) $right-hand-keys)
         (unmod (lctl rctl) ret)
         (lctl rctl))
  navn (tap-hold-tap-keys $tap-time $hold-time n     (layer-while-held nav)     $right-hand-keys)

  ;; ---- Symbol layer, Shift held -> the digit instead of the glyph ----
  ;; The layer's default output is S-1..S-0, so holding Shift on top of it
  ;; changes nothing -- shift-shift is still shift, and `!` stays `!`. To reach
  ;; the digit, Shift has to be taken back OUT, which is what `unmod` does.
  ;; The pairing is therefore the standard one, merely inverted: unshifted
  ;; `m` gives the shifted glyph, `m`+Shift gives the unshifted digit.
  ;;
  ;; z/x/c/v need none of this. Their payloads (tab [ ] `) are unshifted keys,
  ;; so the Shift the user is already holding produces S-tab { } ~ on its own.
  ;;
  ;; Shift itself must come from a physical shift key or from the right-hand
  ;; home row (`;`, still transparent here) -- `a` is occupied by this layer,
  ;; so left-hand home row Shift is not available while `m` is held.
  sy1 (fork S-1 (unmod (lsft rsft) 1) (lsft rsft))
  sy2 (fork S-2 (unmod (lsft rsft) 2) (lsft rsft))
  sy3 (fork S-3 (unmod (lsft rsft) 3) (lsft rsft))
  sy4 (fork S-4 (unmod (lsft rsft) 4) (lsft rsft))
  sy5 (fork S-5 (unmod (lsft rsft) 5) (lsft rsft))
  sy6 (fork S-6 (unmod (lsft rsft) 6) (lsft rsft))
  sy7 (fork S-7 (unmod (lsft rsft) 7) (lsft rsft))
  sy8 (fork S-8 (unmod (lsft rsft) 8) (lsft rsft))
  sy9 (fork S-9 (unmod (lsft rsft) 9) (lsft rsft))
  sy0 (fork S-0 (unmod (lsft rsft) 0) (lsft rsft))

  app1 M-A-C-S-1
  app2 M-A-C-S-2
  app3 M-A-C-S-3
  app4 M-A-C-S-4
  app5 M-A-C-S-5
  app6 M-A-C-S-6
  app7 M-A-C-S-7
)

;; Ctrl-; -> ~  (exact input-combo -> output-combo rewrite)
(defoverrides
  (lctl ;) (lsft grv)
  (rctl ;) (lsft grv)
)

;; Function row: restore the macOS media keys.
;;
;; Karabiner's driver seizes the keyboard BEFORE macOS translates the F-row into
;; brightness/volume/etc. That translation is done by macOS's Apple-keyboard HID
;; driver and only applies to real Apple keyboards, so kanata receives a plain
;; F1..F12 and re-emits it on the Karabiner *virtual* keyboard, which macOS does
;; not treat as an Apple keyboard. Result: every media key silently becomes a
;; dead F-key. Karabiner-Elements did this translation itself, which is why the
;; keys worked before the switch. kanata won't, so do it here.
;; (upstream: jtroo/kanata#1141, #975 -- macOS is unmaintained there)
;;
;; F3/F4 have no HID usage kanata can emit, so they send the equivalent macOS
;; shortcut instead; they break if those shortcuts are ever rebound.
;; F5 (dictation) and F6 (Focus) have neither a usage nor a default shortcut,
;; so they stay dead -- same as they are right now.
;; Real F1..F12 live on the `launch` layer: hold Space and press the key.
(deflayer base
  esc  brdn brup C-up M-spc f5  f6   prev pp   next mute vold volu
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    @ctlb ]   \
  lctl @hma @hms @hmd @hmf g    @ctlh @hmj @hmk @hml @hmsc '   ret
  lsft z    x    c    v    b    @navn @symm ,  .    /    rsft
  lctl lalt lmet @spc rmet ralt
)

;; `m`-hold: the shifted number row, moved onto the left home block.
;; Adding Shift gives the OTHER half of each standard pair, so every key here
;; keeps its real 1/! ,  [/{ ,  `/~ relationship -- just entered inverted,
;; glyph first and digit behind Shift.
;;
;;              m          m + Shift
;;   q w e r t  ! @ # $ %  1 2 3 4 5
;;   a s d f g  ^ & * ( )  6 7 8 9 0
;;   z          tab        S-tab
;;   x          [          {
;;   c          ]          }
;;   v          `          ~
;;
;; Left hand types the symbol, right index holds the layer, so nothing here is
;; a same-hand stretch. The home row mods on `asdf` are shadowed while the
;; layer is held -- deliberate: this layer is for typing, not for chording.
;; S-<n> is used rather than the bare `!`/`@` glyphs so the mapping to the
;; number row stays legible at a glance; see @sy1..@sy0 for how Shift peels
;; that back off.
(deflayer symbols
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @sy1 @sy2 @sy3 @sy4 @sy5 _    _    _    _    _    _    _    _
  _    @sy6 @sy7 @sy8 @sy9 @sy0 _    _    _    _    _    _    _
  _    tab  [    ]    grv  _    _    _    _    _    _    _
  _    _    _    _    _    _
)

;; `n`-hold: arrows on the left home row, in hjkl order shifted one hand over.
;;   a s d f  ->  left down up right
;; The left hand's own mods are shadowed (they ARE the arrows), but the right
;; hand's are not: `k`/`l`/`;` stay transparent, so Opt-Left (word), Ctrl-Left
;; and Shift-Left (select) are all still chordable while navigating. `j` is the
;; exception -- it's the same finger as `n` -- so Cmd-Left/Right for line ends
;; needs physical Left Cmd. One more reason the physical modifiers earn their
;; keep.
(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    left down up   rght _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _
)

;; Space-hold: app slots on the number row, real F-keys on the function row.
(deflayer launch
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _    @app1 @app2 @app3 @app4 @app5 @app6 @app7 _  _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _
)

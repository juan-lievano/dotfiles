# macOS / editor cruft
.DS_Store
*.swp
*.swo

# Machine-specific Claude settings (not portable)
**/.claude/settings.local.json

# aerc credentials must never land in this repo
**/aerc/accounts.conf

# Oryx exports — reference material, not config. The Voyager's source of truth
# is the layout in Oryx (configure.zsa.io/voyager/layouts/waLwq), not a snapshot
# of it, and the source zip carries a compiled .bin besides. Nothing in this
# repo should be a PDF.
*.pdf
zsa_voyager_*_source/

# Python bytecode from importing the scripts in .local/bin
__pycache__/

# Terminal background images for termbg (big, mostly in copyright). Contents
# only, so fd/fzf (^G) can still enter the folder.
backgrounds/*

# Generated by termbg; Ghostty reads it from the linked ~/.config
.config/ghostty/themes/from-image

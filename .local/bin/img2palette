#!/usr/bin/env python3
"""img2palette IMAGE [options]  --  a Ghostty color theme from a picture.

Prints a Ghostty theme (the same 22 lines as its bundled Catppuccin files)
built from the image's colors. Needs ImageMagick 7 (`magick`); no Python
packages.

How the colors are picked
  1. `magick -kmeans` clusters the pixels in CIELAB into --clusters groups.
  2. Each cluster goes to OKLCH (perceptual lightness L, chroma C, hue h).
  3. The twelve chromatic ANSI slots (1-6, 9-14) each take the cluster that
     best matches that slot's Catppuccin color (Mocha, or Latte with --light),
     so the orange cloud can be "bright red" and brown "yellow". Cost is
     mostly hue distance; a cluster further than --tolerance degrees is
     never taken. Slots are NOT ordered by value: ls/git/nvim assume 1 means
     red and 2 means green, so hue is the only ordering that keeps them
     readable. Picks go cheapest first; once a hue family (red+bright red,
     blue+bright blue, ...) has taken a hue, clusters within --repel degrees
     of it cost extra for every OTHER family, so a sky can't be blue, cyan,
     bright blue and bright cyan at once (--repel 0: plain min-cost
     assignment, no such rule).
     A slot with no cluster in reach: if its partner in the family found one,
     it reuses that hue at Catppuccin's lightness ("derived"); otherwise it
     keeps Catppuccin's own color ("synthesized"). Both flagged in the header.
  4. Each slot keeps the cluster's hue and Catppuccin's lightness; chroma may
     run up to 1.6x Catppuccin's. Floor: L >= 0.80 - C/2, so text reads over
     a faint background image whose light regions composite to mid grey.
     Two slots that still land within a hair of each other are pushed apart
     in lightness.
  5. Greys: bg is the cluster nearest Catppuccin's base, set to its
     lightness (or --bg); fg the lightest low-chroma
     one; 0/8 lift the bg, 7/15 sit under fg; all tinted toward the image's
     dominant hue.

Options
  --bg HEX         force the background (default: the cluster nearest
                   Catppuccin's base, at that base's lightness)
  --fg HEX         force the foreground
  --clusters N     k for k-means (default 32; more finds smaller vivid areas)
  --repel DEG      hue exclusion between families (default 25; 0 disables)
  --tolerance DEG  max hue distance a slot accepts (default 64; muted and
                   tiny clusters pay extra, so their reach is shorter)
  --light          light theme: greys flip, chroma slots land at L 0.42-0.58
  --preview PNG    also write a swatch sheet with sample text
  --quantized PNG  the image reduced to its --clusters colors (the k-means
                   result itself, i.e. GIF-style palette compression)
  --remap PNG      the image repainted with only the 16 terminal colors + bg/fg
  --score          instead of a theme, print how many of Catppuccin's eight
                   hue families the image holds (a cluster with chroma and
                   >= 0.5% of pixels within 30 degrees), and each one's share
  --debug          print which cluster each slot took, and why, to stderr
"""
import argparse
import math
import re
import subprocess
import sys

# ---- OKLab <-> sRGB (Björn Ottosson's matrices) -----------------------------


def _srgb_to_lin(c):
    c /= 255.0
    return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4


def _lin_to_srgb(c):
    c = min(1.0, max(0.0, c))
    return 12.92 * c if c <= 0.0031308 else 1.055 * c ** (1 / 2.4) - 0.055


def rgb_to_oklab(r, g, b):
    r, g, b = _srgb_to_lin(r), _srgb_to_lin(g), _srgb_to_lin(b)
    l = 0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b
    m = 0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b
    s = 0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b
    l, m, s = (math.copysign(abs(x) ** (1 / 3), x) for x in (l, m, s))
    return (
        0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s,
        1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s,
        0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s,
    )


def _oklab_to_lin(L, a, b):
    l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3
    m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3
    s = (L - 0.0894841775 * a - 1.2914855480 * b) ** 3
    return (
        +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s,
    )


def lch_to_hex(L, C, h):
    """OKLCH -> #rrggbb, shrinking chroma until the color fits in sRGB."""
    L = min(0.999, max(0.001, L))
    lo, hi = 0.0, C
    for _ in range(24):
        mid = (lo + hi) / 2
        lin = _oklab_to_lin(L, *_ab(mid, h))
        if all(-1e-4 <= x <= 1 + 1e-4 for x in lin):
            lo = mid
        else:
            hi = mid
    lin = _oklab_to_lin(L, *_ab(lo, h))
    return "#%02x%02x%02x" % tuple(round(_lin_to_srgb(x) * 255) for x in lin)


def _ab(C, h):
    return C * math.cos(math.radians(h)), C * math.sin(math.radians(h))


def hex_to_lch(s):
    s = s.lstrip("#")
    r, g, b = (int(s[i : i + 2], 16) for i in (0, 2, 4))
    L, a, bb = rgb_to_oklab(r, g, b)
    return L, math.hypot(a, bb), math.degrees(math.atan2(bb, a)) % 360


def hue_dist(a, b):
    d = abs(a - b) % 360
    return min(d, 360 - d)


# ---- clustering via ImageMagick --------------------------------------------


def clusters(path, k):
    cmd = [
        "magick", path, "-resize", "512x512>", "-colorspace", "LAB",
        "-kmeans", str(k), "-colorspace", "sRGB", "-depth", "8",
        "-format", "%c", "histogram:info:-",
    ]
    out = subprocess.run(cmd, check=True, capture_output=True, text=True).stdout
    rows = []
    for m in re.finditer(r"^\s*(\d+):\s*\(\s*(\d+),\s*(\d+),\s*(\d+)", out, re.M):
        n, r, g, b = map(int, m.groups())
        L, a, bb = rgb_to_oklab(r, g, b)
        rows.append(dict(n=n, L=L, C=math.hypot(a, bb),
                         h=math.degrees(math.atan2(bb, a)) % 360))
    total = sum(c["n"] for c in rows)
    for c in rows:
        c["share"] = c["n"] / total
    return rows


# ---- slot assignment --------------------------------------------------------
#
# Catppuccin is the reference: it already encodes what each ANSI slot should
# look like (hue, lightness, chroma). Each chromatic slot takes the image
# cluster that best matches its Catppuccin color: the orange cloud lands on
# bright red, brown on yellow, and so on. Twelve different clusters is not
# twelve different colors, though -- a painting with one sky gives k-means
# several clusters at the same hue -- so picks are greedy, cheapest first,
# and each pick makes that hue expensive for the other families (MMR-style
# repulsion; --repel 0 falls back to one Hungarian assignment). The result
# keeps the cluster's hue and Catppuccin's lightness; chroma may run hotter
# than Catppuccin's so accents stay "out there" while fg stays neutral.

REF = {  # Mocha for dark, Latte for light; slots 1-6 and 9-14
    "dark": {1: "#f38ba8", 2: "#a6e3a1", 3: "#f9e2af", 4: "#89b4fa", 5: "#f5c2e7",
             6: "#94e2d5", 9: "#f37799", 10: "#89d88b", 11: "#ebd391",
             12: "#74a8fc", 13: "#f2aede", 14: "#6bd7ca"},
    "light": {1: "#d20f39", 2: "#40a02b", 3: "#df8e1d", 4: "#1e66f5", 5: "#ea76cb",
              6: "#179299", 9: "#de293e", 10: "#49af3d", 11: "#eea02d",
              12: "#456eff", 13: "#fe85d8", 14: "#2d9fa8"},
}
REF_BG = {"dark": "#1e1e2e", "light": "#eff1f5"}  # Catppuccin base
NAMES = {1: "red", 2: "green", 3: "yellow", 4: "blue", 5: "magenta", 6: "cyan",
         9: "bright red", 10: "bright green", 11: "bright yellow",
         12: "bright blue", 13: "bright magenta", 14: "bright cyan"}
MIN_CHROMA = 0.045     # below this a cluster counts as grey
# Catppuccin's bright red is pinker than its red; nvim uses 9 for numbers
# (Catppuccin's peach), so pull that slot's target toward orange.
HUE_BIAS = {9: 35, 1: -5}
FAMILY = {s: s % 8 for s in NAMES}   # 1 and 9 are both "red", etc.
# --score: Catppuccin Mocha's accent hues (peach and mauve have no slot of
# their own but are what bright red / magenta tend to become).
FAMILIES = [("red", "#f38ba8"), ("peach", "#fab387"), ("yellow", "#f9e2af"),
            ("green", "#a6e3a1"), ("cyan", "#94e2d5"), ("blue", "#89b4fa"),
            ("mauve", "#cba6f7"), ("pink", "#f5c2e7")]


def hungarian(cost):
    """Min-cost assignment of rows to columns (rows <= cols). Returns col per row."""
    n, m = len(cost), len(cost[0])
    INF = float("inf")
    u, v = [0.0] * (n + 1), [0.0] * (m + 1)
    p, way = [0] * (m + 1), [0] * (m + 1)
    for i in range(1, n + 1):
        p[0] = i
        j0, minv, used = 0, [INF] * (m + 1), [False] * (m + 1)
        while True:
            used[j0] = True
            i0, delta, j1 = p[j0], INF, 0
            for j in range(1, m + 1):
                if not used[j]:
                    cur = cost[i0 - 1][j - 1] - u[i0] - v[j]
                    if cur < minv[j]:
                        minv[j], way[j] = cur, j0
                    if minv[j] < delta:
                        delta, j1 = minv[j], j
            for j in range(m + 1):
                if used[j]:
                    u[p[j]] += delta
                    v[j] -= delta
                else:
                    minv[j] -= delta
            j0 = j1
            if p[j0] == 0:
                break
        while True:
            j1 = way[j0]
            p[j0] = p[j1]
            j0 = j1
            if j0 == 0:
                break
    out = [0] * n
    for j in range(1, m + 1):
        if p[j]:
            out[p[j] - 1] = j - 1
    return out


def greedy(cost, slots, cands, repel, fallback):
    """Cheapest (slot, cluster) pair first. After each pick, every cluster
    within `repel` degrees of the picked hue gets dearer for slots of the
    other families -- up to 2x the fallback cost at zero distance, so an
    identical hue always loses to the fallback. Returns col per row like
    hungarian(); columns >= len(cands) mean "no cluster"."""
    n = len(cands)
    cost = [row[:] for row in cost]
    col, taken = [None] * len(slots), set()
    while None in col:
        best = None
        for i, s in enumerate(slots):
            if col[i] is not None:
                continue
            for j in range(n):
                if j not in taken and (best is None or cost[i][j] < best[0]):
                    best = (cost[i][j], i, j)
            if best is None or fallback < best[0]:
                best = (fallback, i, n)
        _, i, j = best
        col[i] = j
        if j < n:
            taken.add(j)
            for i2, s2 in enumerate(slots):
                if FAMILY[s2] == FAMILY[slots[i]]:
                    continue
                for j2 in range(n):
                    d = hue_dist(cands[j2]["h"], cands[j]["h"])
                    cost[i2][j2] += 2 * fallback * max(0.0, 1 - d / repel)
    return col


def assign(cl, light=False, repel=25, tolerance=64):
    ref = {s: hex_to_lch(h) for s, h in REF["light" if light else "dark"].items()}
    slots = sorted(ref)
    cands = [c for c in cl if c["C"] >= MIN_CHROMA]
    # cost: hue distance dominates (1.0 per 40 degrees); a weak-chroma or tiny
    # cluster costs extra. A slot pays `fallback` to take no cluster at all,
    # so nothing further than --tolerance is ever picked.
    fallback = tolerance / 40
    cost = []
    for s in slots:
        L, C, h = ref[s]
        h = (h + HUE_BIAS.get(s, 0)) % 360
        row = []
        for c in cands:
            row.append(hue_dist(c["h"], h) / 40
                       + 0.6 * max(0.0, 0.09 - c["C"]) / 0.05
                       + 0.15 * max(0.0, 1 - c["share"] / 0.03))
        cost.append(row)
    if repel > 0:
        col = greedy(cost, slots, cands, repel, fallback)
    else:
        col = hungarian([row + [fallback] * len(slots) for row in cost])
    picked, synth, debug = {}, [], []
    for s, j in zip(slots, col):
        L, C, h = ref[s]
        if j < len(cands):
            c = cands[j]
            picked[s] = dict(L=L, C=min(max(c["C"], C * 0.9), C * 1.6), h=c["h"], share=c["share"])
            debug.append(f"{s:>2} {NAMES[s]:<15} cluster L={c['L']:.2f} C={c['C']:.3f} h={c['h']:4.0f} share={c['share']*100:4.1f}%  hue-dist={hue_dist(c['h'], (h + HUE_BIAS.get(s, 0)) % 360):3.0f}  cost={cost[slots.index(s)][j]:.2f}")
    # no cluster in reach: borrow the family partner's hue (an olive green
    # wants an olive bright green, not Catppuccin's mint), else Catppuccin's.
    for s in slots:
        if s in picked:
            continue
        L, C, h = ref[s]
        partner = s + 8 if s < 8 else s - 8
        if partner in picked and picked[partner]["share"]:
            p = picked[partner]
            picked[s] = dict(L=L, C=min(max(p["C"], C * 0.9), C * 1.6), h=p["h"], share=0)
            synth.append(f"{NAMES[s]} (from {NAMES[partner]})")
            debug.append(f"{s:>2} {NAMES[s]:<15} derived from {NAMES[partner]}'s hue")
        else:
            picked[s] = dict(L=L, C=C, h=h, share=0)
            synth.append(NAMES[s])
            debug.append(f"{s:>2} {NAMES[s]:<15} synthesized (Catppuccin's own)")
    return picked, synth, debug


def spread(picked):
    """Two slots within a hair of each other (same hue, similar lightness):
    push the later one's lightness apart. Runs after the legibility floor,
    which would otherwise fold nudged pairs back together."""
    done = []
    for s in sorted(picked):
        c = picked[s]
        for o in done:
            a1, b1 = _ab(c["C"], c["h"])
            a2, b2 = _ab(o["C"], o["h"])
            if math.dist((c["L"], a1, b1), (o["L"], a2, b2)) < 0.09:
                c["L"] += 0.08 if c["L"] < 0.84 else -0.08
                c["C"] *= 1.25
        done.append(c)


def score(cl):
    """Which of Catppuccin's hue families the image holds, and how much."""
    out = {}
    for name, hx in FAMILIES:
        h = hex_to_lch(hx)[2]
        out[name] = max((c["share"] for c in cl
                         if c["C"] >= MIN_CHROMA and hue_dist(c["h"], h) <= 30), default=0.0)
    families = sum(v >= 0.005 for v in out.values())
    chromatic = sum(c["share"] for c in cl if c["C"] >= MIN_CHROMA)
    return f"families={families} chromatic={chromatic*100:.0f}% " + \
        " ".join(f"{k}={v*100:.1f}" for k, v in out.items())


def build(cl, bg=None, fg=None, light=False, debug=False, repel=25, tolerance=64):
    picked, synth, dbg = assign(cl, light, repel, tolerance)
    if debug:
        sys.stderr.write("\n".join(dbg) + "\n")
    weighted = sorted(cl, key=lambda c: -c["share"])
    dom = next((c for c in weighted if c["C"] >= MIN_CHROMA), weighted[0])
    tint = dom["h"]

    if bg:
        bgL, bgC, bgh = hex_to_lch(bg)
    else:
        # the cluster nearest Catppuccin's base, at Catppuccin's base lightness:
        # a dark tint of the image rather than black.
        rL, rC, rh = hex_to_lch(REF_BG["light" if light else "dark"])
        ra, rb = _ab(rC, rh)
        d = min(cl, key=lambda c: math.dist((c["L"], *_ab(c["C"], c["h"])), (rL, ra, rb)))
        bgL, bgC, bgh = rL, min(d["C"], 0.05), d["h"]
    if fg:
        fgL, fgC, fgh = hex_to_lch(fg)
    else:
        greys = [c for c in cl if c["C"] < 0.06] or cl
        f = max(greys, key=lambda c: c["L"]) if not light else min(greys, key=lambda c: c["L"])
        fgL = max(f["L"], 0.85) if not light else min(f["L"], 0.32)
        fgC, fgh = min(f["C"], 0.04), f["h"]

    sign = -1 if light else 1
    for c in picked.values():
        # legibility over a faint background image, whose light regions
        # composite to mid grey: vivid colors may sit lower than muted ones.
        c["L"] = max(c["L"], 0.80 - c["C"] / 2) if not light else min(c["L"], 0.55)
    spread(picked)
    pal = {s: lch_to_hex(c["L"], c["C"], c["h"]) for s, c in picked.items()}
    # 0/8 (comments, selection) need a floor: +0.24 over pure black is mud.
    g0, g8 = (min(bgL - 0.14, 0.72), min(bgL - 0.26, 0.58)) if light else \
             (max(bgL + 0.14, 0.36), max(bgL + 0.24, 0.64))
    pal[0] = lch_to_hex(g0, 0.02, bgh)
    pal[8] = lch_to_hex(g8, 0.025, bgh)
    pal[7] = lch_to_hex(fgL - 0.08 * sign, fgC, fgh)
    pal[15] = lch_to_hex(fgL, fgC, fgh)

    theme = {
        "background": lch_to_hex(bgL, bgC, bgh),
        "foreground": lch_to_hex(fgL, fgC, fgh),
        "cursor-color": lch_to_hex(fgL, 0.06, tint),
    }
    theme["cursor-text"] = theme["background"]
    theme["selection-background"] = pal[8]
    theme["selection-foreground"] = theme["foreground"]
    return pal, theme, synth


# ---- output -----------------------------------------------------------------


def render(pal, theme, synth, src):
    lines = [f"# generated by img2palette from {src}"]
    if synth:
        lines.append("# not from a cluster of their own: " + ", ".join(synth))
    lines += [f"palette = {i}={pal[i]}" for i in range(16)]
    lines += [f"{k} = {v}" for k, v in theme.items()]
    return "\n".join(lines) + "\n"


def preview(pal, theme, out):
    bg, fg = theme["background"], theme["foreground"]
    sw = lambda i: ["(", "-size", "72x48", f"xc:{pal[i]}", ")"]
    row = lambda r: ["("] + sum((sw(i) for i in r), []) + ["+append", ")"]
    cmd = ["magick", "-background", bg, "-fill", fg, "-pointsize", "22",
           row(range(8)), row(range(8, 16)),
           "(", "-size", "576x48", f"xc:{bg}", "-gravity", "west", "-fill", fg,
           "-annotate", "+12+0", "foreground on background", ")",
           "(", "-size", "576x48", f"xc:{theme['cursor-color']}", "-gravity", "west",
           "-fill", theme["cursor-text"], "-annotate", "+12+0", "cursor", ")",
           "(", "-size", "576x48", f"xc:{theme['selection-background']}", "-gravity",
           "west", "-fill", theme["selection-foreground"], "-annotate", "+12+0",
           "selection", ")"]
    for i, word in zip(range(1, 7), ["error", "added", "warn", "dir", "str", "info"]):
        cmd += ["(", "-size", "576x48", f"xc:{bg}", "-gravity", "west", "-fill",
                pal[i], "-annotate", "+12+0", f"{i}  {word}   ", "-fill", pal[i + 8],
                "-annotate", "+300+0", f"{i+8}  bright", ")"]
    flat = []
    for c in cmd:
        flat += c if isinstance(c, list) else [c]
    flat += ["-append", out]
    subprocess.run(flat, check=True)


def quantized(path, k, out):
    subprocess.run(["magick", path, "-resize", "1024x1024>", "-colorspace", "LAB",
                    "-kmeans", str(k), "-colorspace", "sRGB", out], check=True)


def remap(path, pal, theme, out):
    colors = [pal[i] for i in range(16)] + [theme["background"], theme["foreground"]]
    strip = ["magick"] + sum((["xc:" + c] for c in colors), []) + ["+append", "miff:-"]
    png = subprocess.run(strip, check=True, capture_output=True).stdout
    subprocess.run(["magick", path, "-resize", "1024x1024>", "-dither", "None",
                    "-remap", "miff:-", out], input=png, check=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("image")
    ap.add_argument("--bg")
    ap.add_argument("--fg")
    ap.add_argument("--clusters", type=int, default=32)
    ap.add_argument("--repel", type=float, default=25, metavar="DEG")
    ap.add_argument("--tolerance", type=float, default=64, metavar="DEG")
    ap.add_argument("--light", action="store_true")
    ap.add_argument("--preview", metavar="PNG")
    ap.add_argument("--quantized", metavar="PNG")
    ap.add_argument("--remap", metavar="PNG")
    ap.add_argument("--score", action="store_true", help="print hue-family coverage instead of a theme")
    ap.add_argument("--debug", action="store_true", help="print the slot assignment to stderr")
    a = ap.parse_args()
    cl = clusters(a.image, a.clusters)
    if a.score:
        print(score(cl))
        return
    pal, theme, synth = build(cl, a.bg, a.fg, a.light, a.debug, a.repel, a.tolerance)
    sys.stdout.write(render(pal, theme, synth, a.image))
    if a.preview:
        preview(pal, theme, a.preview)
    if a.quantized:
        quantized(a.image, a.clusters, a.quantized)
    if a.remap:
        remap(a.image, pal, theme, a.remap)


if __name__ == "__main__":
    main()

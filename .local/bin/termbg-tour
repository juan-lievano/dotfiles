#!/bin/sh
# termbg-tour [SECONDS] [termbg options]
#
# Walk the daily pool (every picture with enough hue families, see
# termbg-daily) through the terminal, one after another, staying SECONDS
# (default 5) on each after the switch lands. Ctrl-C stops on the one you're
# looking at. Each switch itself takes ~3-6 s (blur + k-means), so the real
# cadence is SECONDS plus that. Extra arguments go to termbg, e.g.
#   termbg-tour 8 --tolerance 30
set -eu

state=$HOME/Pictures/terminal/daily
min=${TERMBG_MIN:-4}
secs=${1:-5}; [ $# -gt 0 ] && shift

[ -s "$state/pool.txt" ] || { echo "no pool yet: termbg-daily scan DIR" >&2; exit 1; }
awk -F'\t' -v m="$min" '$1 >= m { print $2 }' "$state/pool.txt" | while IFS= read -r img; do
    printf '\n\033[1m%s\033[0m\n' "$(basename "$img")"
    termbg "$img" "$@" | grep -E '^# not|Cmd-Shift' || true
    sleep "$secs"
done

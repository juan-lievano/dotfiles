{
  "permissions": {
    "allow": [
      "Edit(~/.config/**)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.config/"
    ]
  },
  "model": "fable",
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true
  },
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "terminal_bell",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/wezterm-bell.sh",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}

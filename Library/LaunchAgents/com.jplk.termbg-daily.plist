<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jplk.termbg-daily</string>

  <!-- ~/.local/bin/termbg-daily with no argument: switches the terminal
       picture once per calendar day, exits 0 otherwise. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jplk/.local/bin/termbg-daily</string>
  </array>

  <!-- 05:00; launchd runs a missed one on wake, unlike cron. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- and at login, in case the machine was off at 05:00 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- launchd's PATH has neither Homebrew (magick) nor ~/.local/bin -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/jplk/.local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/jplk/Library/Logs/termbg-daily.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jplk/Library/Logs/termbg-daily.log</string>
</dict>
</plist>
